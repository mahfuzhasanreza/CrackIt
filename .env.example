# Copy to .env and fill in. Never commit .env.
# Values are validated at startup by src/lib/env.ts.

# --- Database ---
# Local: `pnpm db:up` starts Postgres on port 5433 (docker-compose.yml).
# Prod (Neon): the *pooled* connection string.
DATABASE_URL="postgresql://crackit:crackit@localhost:5433/crackit"
# Prod (Neon) only: the *direct* connection string, used by prisma migrate. Leave unset locally.
# DIRECT_URL=""

# Integration tests (docker compose service postgres-test).
TEST_DATABASE_URL="postgresql://crackit:crackit@localhost:5434/crackit_test"

# Optional: email of the dev user created by `pnpm db:seed`.
# SEED_USER_EMAIL="dev@crackit.local"

# --- Auth ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: password given to the dev user by `pnpm db:seed` (dev only, min 12 chars).
# SEED_USER_PASSWORD="crackit-dev-password"
