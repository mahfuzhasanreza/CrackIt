# Copy to .env and fill in. Never commit .env.
# Values are validated at startup by src/lib/env.ts.

# --- Database (Phase 1) ---
# Local: docker compose Postgres. Prod: Neon pooled URL.
# DATABASE_URL="postgresql://crackit:crackit@localhost:5432/crackit"
# Prod only: Neon direct (non-pooled) URL, used by prisma migrate.
# DIRECT_URL="postgresql://crackit:crackit@localhost:5432/crackit"

# --- Auth (Phase 2) ---
# Generate with: openssl rand -base64 32
# AUTH_SECRET=""
