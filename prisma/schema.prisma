// CrackIt database schema.
// Conventions: snake_case tables/columns via @map, UUIDv7 ids, timestamptz everywhere,
// every user-owned row has user_id + created_at + updated_at.
// Constraints Prisma can't express (partial/NULLS NOT DISTINCT indexes, CHECKs) are added as
// raw SQL in the migration files — create with `pnpm db:migrate --create-only`, then edit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Core ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  email          String   @unique // always stored lower-cased
  name           String?
  /// argon2id hash. NULL = no password set yet (cannot log in).
  passwordHash   String?  @map("password_hash")
  /// Bumped on password change/reset; JWTs carrying an older version are rejected.
  sessionVersion Int      @default(0) @map("session_version")
  timezone       String   @default("Asia/Dhaka") // IANA tz name
  /// Hour (0-23, local time) at which a "day" starts. 4 = a day runs 04:00 → 04:00.
  dayStartHour   Int      @default(4) @map("day_start_hour") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tracks                   Track[]
  topics                   Topic[]
  activityTypes            ActivityType[]
  timeEntries              TimeEntry[]
  dailyLogs                DailyLog[]
  learningEntries          LearningEntry[]
  tags                     Tag[]
  checklists               Checklist[]
  checklistItems           ChecklistItem[]
  checklistItemCompletions ChecklistItemCompletion[]
  problems                 Problem[]
  projects                 Project[]
  courses                  Course[]
  teachingDemos            TeachingDemo[]
  publications             Publication[]
  vivaQuestions            VivaQuestion[]
  organizations            Organization[]
  applications             Application[]
  applicationEvents        ApplicationEvent[]
  interviews               Interview[]
  mockInterviews           MockInterview[]
  resources                Resource[]

  @@map("users")
}

/// A prep track, e.g. "SWE / Full-Stack" or "University Lecturer".
model Track {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  description         String?
  color               String // hex, e.g. #2563eb
  weeklyTargetMinutes Int?     @map("weekly_target_minutes")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics          Topic[]
  timeEntries     TimeEntry[]
  learningEntries LearningEntry[]
  checklists      Checklist[]
  applications    Application[]
  mockInterviews  MockInterview[]
  resources       Resource[]

  @@unique([userId, name])
  @@map("tracks")
}

enum TopicStatus {
  NOT_STARTED
  LEARNING
  REVISING
  CONFIDENT

  @@map("topic_status")
}

/// Hierarchical roadmap item inside a track (e.g. DSA → Graphs → Dijkstra).
model Topic {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  trackId   String      @map("track_id") @db.Uuid
  parentId  String?     @map("parent_id") @db.Uuid
  name      String
  status    TopicStatus @default(NOT_STARTED)
  /// 0 = normal, higher = more important
  priority  Int         @default(0) @db.SmallInt
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track           Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  parent          Topic?          @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Topic[]         @relation("TopicTree")
  timeEntries     TimeEntry[]
  learningEntries LearningEntry[]
  problems        Problem[]

  // In SQL this index is NULLS NOT DISTINCT so root topics (parent_id NULL) are unique too.
  @@unique([trackId, parentId, name])
  @@index([userId, trackId])
  @@index([parentId])
  @@map("topics")
}

/// Every login attempt, for rate limiting / lockout and auditing.
model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String // lower-cased input, may not match a real user
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ─── Time tracking ───────────────────────────────────────────────────────────

enum ActivityCategory {
  STUDY
  SLEEP
  BREAK
  WORK
  EXERCISE
  PERSONAL
  OTHER

  @@map("activity_category")
}

/// What a time entry is spent on: Study, Sleep, Break/Gap, Meal, ... (user-configurable).
model ActivityType {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  name         String
  color        String
  category     ActivityCategory
  isProductive Boolean          @default(false) @map("is_productive")
  isArchived   Boolean          @default(false) @map("is_archived")
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([userId, name])
  @@map("activity_types")
}

enum TimeEntrySource {
  TIMER
  MANUAL

  @@map("time_entry_source")
}

/// A block of time spent on one activity. ended_at NULL = the running timer.
/// DB-enforced (raw SQL in the migration): at most one running entry per user, no overlapping
/// entries per user (GiST exclusion on tstzrange), ended_at > started_at, focus 1-5.
model TimeEntry {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  activityTypeId String          @map("activity_type_id") @db.Uuid
  trackId        String?         @map("track_id") @db.Uuid
  topicId        String?         @map("topic_id") @db.Uuid
  startedAt      DateTime        @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(3)
  source         TimeEntrySource @default(TIMER)
  note           String?
  /// 1 (distracted) – 5 (deep focus)
  focusRating    Int?            @map("focus_rating") @db.SmallInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: archive an activity type instead of deleting one that has history.
  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  track        Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)
  topic        Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([trackId])
  @@index([topicId])
  @@index([activityTypeId])
  @@map("time_entries")
}

// ─── Journal & learning log ──────────────────────────────────────────────────

/// One journal page per logical day. Ratings are 1–5 (CHECKs in the migration).
/// bed_at = when the user went to sleep before this day; wake_at = when they woke for it.
model DailyLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Logical day (see dayStartHour), not a UTC calendar date.
  date         DateTime  @db.Date
  mood         Int?      @db.SmallInt
  energy       Int?      @db.SmallInt
  sleepQuality Int?      @map("sleep_quality") @db.SmallInt
  bedAt        DateTime? @map("bed_at") @db.Timestamptz(3)
  wakeAt       DateTime? @map("wake_at") @db.Timestamptz(3)
  planForDay   String?   @map("plan_for_day")
  reflection   String?
  wins         String?
  blockers     String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_logs")
}

/// "What I learned": a markdown note, optionally on a track/topic, with spaced-repetition state.
model LearningEntry {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Logical day it was learned.
  date           DateTime  @db.Date
  trackId        String?   @map("track_id") @db.Uuid
  topicId        String?   @map("topic_id") @db.Uuid
  title          String
  contentMd      String    @default("") @map("content_md")
  sourceUrl      String?   @map("source_url")
  /// 1 (shaky) – 5 (could teach it)
  confidence     Int?      @db.SmallInt
  /// Next logical day to revise. NULL = not scheduled (or finished the schedule).
  revisitOn      DateTime? @map("revisit_on") @db.Date
  /// Successful reviews in a row (index into the 1/3/7/14/30-day schedule).
  reviewStage    Int       @default(0) @map("review_stage") @db.SmallInt
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Notes outlive tracks/topics: removing one just unlinks the note.
  track Track?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  topic Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tags  LearningEntryTag[]

  @@index([userId, date])
  @@index([userId, revisitOn])
  @@index([trackId])
  @@index([topicId])
  @@map("learning_entries")
}

/// Generic per-user tag (learning entries, problem patterns). Names are stored lower-case.
model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningEntries LearningEntryTag[]
  problems        ProblemTag[]

  @@unique([userId, name])
  @@map("tags")
}

model LearningEntryTag {
  learningEntryId String @map("learning_entry_id") @db.Uuid
  tagId           String @map("tag_id") @db.Uuid

  learningEntry LearningEntry @relation(fields: [learningEntryId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([learningEntryId, tagId])
  @@index([tagId])
  @@map("learning_entry_tags")
}

// ─── Checklists & habits ─────────────────────────────────────────────────────

enum ChecklistType {
  ROADMAP
  ONE_OFF
  HABIT

  @@map("checklist_type")
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY

  @@map("recurrence")
}

/// A list of items. HABIT lists recur (DAILY/WEEKLY) and are ticked per period; the others are
/// ticked once (done_at). CHECK in the migration: recurrence <> NONE exactly when type = HABIT.
model Checklist {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  trackId     String?       @map("track_id") @db.Uuid
  title       String
  description String?
  type        ChecklistType
  recurrence  Recurrence    @default(NONE)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track?          @relation(fields: [trackId], references: [id], onDelete: SetNull)
  items ChecklistItem[]

  @@index([userId, sortOrder])
  @@index([trackId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  checklistId String    @map("checklist_id") @db.Uuid
  title       String
  sortOrder   Int       @default(0) @map("sort_order")
  /// Logical day it's due (non-habit lists).
  dueOn       DateTime? @map("due_on") @db.Date
  /// 0 normal, 1 high, 2 urgent
  priority    Int       @default(0) @db.SmallInt
  /// When a non-recurring item was ticked. Habits use completions instead.
  doneAt      DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist   Checklist                 @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completions ChecklistItemCompletion[]

  @@index([checklistId, sortOrder])
  @@index([userId, dueOn])
  @@map("checklist_items")
}

/// A habit ticked for one period: the logical day (DAILY) or the Monday of the week (WEEKLY).
model ChecklistItemCompletion {
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  period    DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, period])
  @@index([userId, period])
  @@map("checklist_item_completions")
}

// ─── SWE prep: problems & projects ───────────────────────────────────────────

enum ProblemPlatform {
  LEETCODE
  CODEFORCES
  HACKERRANK
  ATCODER
  GEEKSFORGEEKS
  CODECHEF
  OTHER

  @@map("problem_platform")
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD

  @@map("problem_difficulty")
}

enum ProblemStatus {
  TODO
  ATTEMPTED
  SOLVED
  NEEDS_REVISION

  @@map("problem_status")
}

/// A DSA problem. Patterns are tags. Solved problems follow the same 1/3/7/14/30-day revision
/// schedule as learning notes (next_review_on / review_stage).
model Problem {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  topicId        String?           @map("topic_id") @db.Uuid
  title          String
  platform       ProblemPlatform   @default(LEETCODE)
  url            String?
  difficulty     ProblemDifficulty @default(MEDIUM)
  status         ProblemStatus     @default(TODO)
  attempts       Int               @default(0)
  timeSpentMin   Int               @default(0) @map("time_spent_min")
  solvedAt       DateTime?         @map("solved_at") @db.Timestamptz(3)
  notesMd        String            @default("") @map("notes_md")
  nextReviewOn   DateTime?         @map("next_review_on") @db.Date
  reviewStage    Int               @default(0) @map("review_stage") @db.SmallInt
  lastReviewedAt DateTime?         @map("last_reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tags  ProblemTag[]

  @@index([userId, status])
  @@index([userId, nextReviewOn])
  @@index([topicId])
  @@map("problems")
}

model ProblemTag {
  problemId String @map("problem_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@index([tagId])
  @@map("problem_tags")
}

enum ProjectStatus {
  PLANNING
  BUILDING
  SHIPPED
  PAUSED

  @@map("project_status")
}

/// Portfolio project to talk about in interviews.
model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String
  description String?
  repoUrl     String?       @map("repo_url")
  liveUrl     String?       @map("live_url")
  /// Technologies, as entered (e.g. ["Next.js", "PostgreSQL"]).
  stack       String[]      @default([])
  status      ProjectStatus @default(BUILDING)
  notesMd     String        @default("") @map("notes_md")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@map("projects")
}

// ─── Lecturer prep ───────────────────────────────────────────────────────────

/// A subject you may be asked to teach.
model Course {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  code        String?
  syllabusUrl String?  @map("syllabus_url")
  /// 1 (not ready) – 5 (could teach it tomorrow)
  readiness   Int      @default(1) @db.SmallInt
  notesMd     String   @default("") @map("notes_md")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingDemos TeachingDemo[]
  vivaQuestions VivaQuestion[]

  @@unique([userId, name])
  @@map("courses")
}

enum DemoAudience {
  SELF
  RECORDED
  MOCK_PANEL
  LIVE_CLASS

  @@map("demo_audience")
}

/// A practice (or real) teaching demo.
model TeachingDemo {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  courseId     String?      @map("course_id") @db.Uuid
  topic        String
  /// Logical day it was given.
  date         DateTime     @db.Date
  durationMin  Int          @map("duration_min")
  audience     DemoAudience @default(SELF)
  /// 1–5
  selfScore    Int?         @map("self_score") @db.SmallInt
  feedbackMd   String       @default("") @map("feedback_md")
  recordingUrl String?      @map("recording_url")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([courseId])
  @@map("teaching_demos")
}

enum PublicationStatus {
  IDEA
  WRITING
  SUBMITTED
  ACCEPTED
  PUBLISHED
  REJECTED

  @@map("publication_status")
}

/// A paper. Submitted or later requires submitted_on (CHECK in the migration).
model Publication {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  title       String
  venue       String?
  status      PublicationStatus @default(IDEA)
  submittedOn DateTime?         @map("submitted_on") @db.Date
  url         String?
  notesMd     String            @default("") @map("notes_md")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("publications")
}

/// Viva / board question with a model answer, practised on the spaced-repetition schedule.
model VivaQuestion {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  courseId        String?   @map("course_id") @db.Uuid
  question        String
  answerMd        String    @default("") @map("answer_md")
  nextReviewOn    DateTime? @map("next_review_on") @db.Date
  reviewStage     Int       @default(0) @map("review_stage") @db.SmallInt
  lastPracticedAt DateTime? @map("last_practiced_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, nextReviewOn])
  @@index([courseId])
  @@map("viva_questions")
}

// ─── Job hunt ────────────────────────────────────────────────────────────────

enum OrganizationType {
  COMPANY
  UNIVERSITY

  @@map("organization_type")
}

model Organization {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  name      String
  type      OrganizationType @default(COMPANY)
  website   String?
  location  String?
  notesMd   String           @default("") @map("notes_md")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
  @@map("organizations")
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  OA
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN

  @@map("application_status")
}

/// A job application. Status changes are logged in application_events.
model Application {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  trackId        String?           @map("track_id") @db.Uuid
  role           String
  jobUrl         String?           @map("job_url")
  source         String?
  status         ApplicationStatus @default(WISHLIST)
  appliedOn      DateTime?         @map("applied_on") @db.Date
  deadlineOn     DateTime?         @map("deadline_on") @db.Date
  salaryRange    String?           @map("salary_range")
  notesMd        String            @default("") @map("notes_md")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deleting an organization deletes its applications (the UI confirms with a count).
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  track        Track?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  events       ApplicationEvent[]
  interviews   Interview[]

  @@index([userId, status])
  @@index([organizationId])
  @@index([trackId])
  @@map("applications")
}

/// Pipeline history: one row per status change (from NULL = created).
model ApplicationEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  at            DateTime           @default(now()) @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@index([userId, at])
  @@map("application_events")
}

enum InterviewRound {
  SCREENING
  OA
  TECHNICAL
  SYSTEM_DESIGN
  BEHAVIORAL
  HR
  TEACHING_DEMO
  VIVA
  WRITTEN

  @@map("interview_round")
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED

  @@map("interview_outcome")
}

model Interview {
  id            String           @id @default(uuid(7)) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  applicationId String           @map("application_id") @db.Uuid
  round         InterviewRound
  scheduledAt   DateTime         @map("scheduled_at") @db.Timestamptz(3)
  durationMin   Int?             @map("duration_min")
  interviewer   String?
  questionsMd   String           @default("") @map("questions_md")
  myAnswersMd   String           @default("") @map("my_answers_md")
  outcome       InterviewOutcome @default(PENDING)
  /// 1–5
  selfRating    Int?             @map("self_rating") @db.SmallInt
  lessonsMd     String           @default("") @map("lessons_md")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([applicationId])
  @@map("interviews")
}

/// Practice interview (Pramp, a friend, a mentor...).
model MockInterview {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  trackId    String?        @map("track_id") @db.Uuid
  /// Logical day.
  date       DateTime       @db.Date
  partner    String?
  type       InterviewRound
  /// 1–5
  score      Int?           @db.SmallInt
  feedbackMd String         @default("") @map("feedback_md")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([trackId])
  @@map("mock_interviews")
}

// ─── Resources ───────────────────────────────────────────────────────────────

enum ResourceType {
  BOOK
  COURSE
  VIDEO
  ARTICLE
  SHEET
  OTHER

  @@map("resource_type")
}

enum ResourceStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DROPPED

  @@map("resource_status")
}

/// A book, course, video series, article or problem sheet, with unit-based progress.
model Resource {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  trackId        String?        @map("track_id") @db.Uuid
  title          String
  author         String?
  type           ResourceType
  url            String?
  /// What a unit is ("chapters", "lessons", …). NULL = the type's default.
  unitLabel      String?        @map("unit_label")
  /// NULL = open-ended (progress is a count only).
  totalUnits     Int?           @map("total_units")
  completedUnits Int            @default(0) @map("completed_units")
  status         ResourceStatus @default(PLANNED)
  startedOn      DateTime?      @map("started_on") @db.Date
  finishedOn     DateTime?      @map("finished_on") @db.Date
  rating         Int?           @db.SmallInt
  notesMd        String         @default("") @map("notes_md")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("resources")
}
